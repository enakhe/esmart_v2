<Window x:Class="ESMART.Presentation.Forms.Laundry.AddLaundaryOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ESMART.Presentation.Forms.Laundry"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#f0f4f9"
        ResizeMode="CanResize"
        Title="Add Laundary Order" Height="800" Width="1200" Icon="/Forms/Laundry/logo.png" Loaded="Window_Loaded">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10" Margin="30" Padding="20" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtSearch" Grid.Column="0" />
                        <Button Content="Search" x:Name="SearchButton" Height="34" Grid.Column="1" Margin="5" Padding="0,5,0,5" Background="#4ead16" Foreground="White" Cursor="Hand" Click="SearchButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="20,0,5,0">
                            <TextBlock Text="Category:" FontWeight="Bold" />
                            <ComboBox x:Name="cmbCategory" Padding="2,5,0,5" Width="300" SelectionChanged="cmbCategory_SelectionChanged" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2" Margin="0,20" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GroupedLaundryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,20">
                                        <TextBlock Text="{Binding CategoryName}" FontSize="18" FontWeight="Bold" Margin="10,0" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="180" Height="200" Padding="10" Margin="5" CornerRadius="10" Background="#1a237e" Tag="{Binding}">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" 
                   MaxWidth="150" MaxHeight="40" FontSize="14" Foreground="White" 
                   HorizontalAlignment="Center" TextAlignment="Center"/>

                                                            <!-- Laundry Price -->
                                                            <TextBlock FontSize="14" Foreground="White" Margin="0,10" HorizontalAlignment="Center">
            <Run Text="₦" />
            <Run Text="{Binding LaundryPrice, StringFormat=N2}" />
                                                            </TextBlock>

                                                            <!-- Checkbox for Pressing Option -->
                                                            


                                                            <!-- Add Button -->
                                                            <Button Width="30" Height="30" Margin="5" Padding="2" ToolTip="Add" Background="White" Foreground="White" Cursor="Hand" 
                x:Name="AddButton" Tag="{Binding Id}" FontFamily="Segoe UI Emoji" Click="AddButton_Click">
                                                                <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Foreground="Black"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>


                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Background="White" CornerRadius="10" Margin="30" Padding="20" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,0,5,0">
                        <TextBlock Text="Active Booking:" FontWeight="Bold" />
                        <ComboBox x:Name="cmbActiveBooking" Padding="2,5,0,5" />
                    </StackPanel>

                    <StackPanel Margin="20" Grid.Row="1">
                        <TextBlock Text="Cart" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ItemsControl ItemsSource="{Binding CartItems}" Grid.Row="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <CheckBox Content="Press/Iron" 
IsChecked="{Binding IsPressingSelected, Mode=TwoWay}" 
Foreground="White"
BorderBrush="White" 
BorderThickness="2"
HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Width="200" Margin="0,0,20,0" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Quantity}" Width="30"/>
                                            <TextBlock Text="{Binding TotalPrice, StringFormat=N2}" Width="60"/>
                                            <Button  Width="30" HorizontalAlignment="Center" Height="30" Padding="2" ToolTip="Delete" Background="White" Foreground="White" Cursor="Hand" x:Name="RemoveCart" Tag="{Binding Id}" FontFamily="Segoe UI Emoji" Click="RemoveCart_Click" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Minus" Width="20" Height="20" Foreground="Black"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                <TextBlock Text="Total:" FontWeight="Bold" Margin="0,20,0,5"/>
                                <TextBlock Text="{Binding DataContext.TotalAmount, RelativeSource={RelativeSource AncestorType=Window},  StringFormat=₦{0:N2}}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                        <TextBlock Text="Account Number:" FontWeight="Bold" />
                                        <ComboBox x:Name="cmbAccountNumber" Padding="2,5,0,5" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                        <TextBlock Text="Payment Method:" FontWeight="Bold" />
                                        <ComboBox x:Name="cmbPaymentMethod" Padding="2,5,0,5" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Button Content="Order" x:Name="Order" Height="34" Margin="5" Padding="0,5,0,5" Background="#4ead16" Foreground="White" Cursor="Hand" Click="Order_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="LoaderOverlay" Background="Black" Opacity="0.5" Visibility="Collapsed" Grid.ColumnSpan="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20" />
                <TextBlock Text="Loading, please wait..." Foreground="White" FontWeight="Bold" Margin="10,5,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
